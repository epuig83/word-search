{
  "name": "rachel-exercises",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build:locales": "node scripts/generate-localized-pages.js",
    "check:locales": "node scripts/generate-localized-pages.js --check",
    "build:offline": "node scripts/generate-offline-manifest.js",
    "check:offline": "node scripts/generate-offline-manifest.js --check",
    "lint": "eslint .",
    "security:audit": "pnpm audit --audit-level high",
    "test": "pnpm lint && pnpm check:locales && pnpm check:offline && pnpm test:unit && pnpm test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4"
  }
}
